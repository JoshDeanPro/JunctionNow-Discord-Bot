      "name": "Read JunctionNow Feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "jsCode": "const clean = value => String(value || '').replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/\\s+/g, ' ').trim();\nreturn $input.all().slice(0, 100).map(item => {\n  const source = item.json;\n  const url = source.link || source.guid || '';\n  const title = clean(source.title).replace(/\\s*[-|\\u2013\\u2014]\\s*JunctionNow\\.com\\s*$/i, '').trim();\n  const body = clean(source.contentSnippet || source.content || source.summary).slice(0, 4000);\n  const published_at = source.isoDate || source.pubDate || '';\n  return {json: {source_id: source.guid || url, title, url, body, published_at, signature: JSON.stringify([title, body, url])}};\n});"
      },
      "id": "2a6cb43b-f84e-4113-a8b0-824b7d15fb1a",
      "name": "Normalize Current Posts",
