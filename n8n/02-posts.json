    {
      "parameters": {},
      "id": "ee4f501c-268f-4169-a337-c201beb3226a",
      "name": "Update Posts Now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 120]
    },
    {
      "parameters": {"url": "https://junctionnow.com/feed/"},
      "id": "ffda4816-d0ab-4624-a359-7275363fcba4",
      "name": "Read JunctionNow Feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "jsCode": "const clean = value => String(value || '').replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/\\s+/g, ' ').trim();\nreturn $input.all().slice(0, 100).map(item => {\n  const source = item.json;\n  const url = source.link || source.guid || '';\n  const title = clean(source.title).replace(/\\s*[-|\\u2013\\u2014]\\s*JunctionNow\\.com\\s*$/i, '').trim().slice(0, 256) || 'JunctionNow';\n  const body = clean(source.contentSnippet || source.content || source.summary).slice(0, 4000);\n  const published_at = source.isoDate || source.pubDate || '';\n  return {json: {source_id: source.guid || url, title, url, body, published_at, signature: JSON.stringify([title, body, url])}};\n});"
      },
      "id": "aac98429-e77b-4613-8c8f-d3ddc43a97f5",
      "name": "Normalize Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {"__rl": true, "value": "JunctionNow Posts", "mode": "name"},
        "returnAll": false,
        "limit": 1,
        "matchType": "allConditions",
        "filters": {"conditions": [{"keyName": "source_id", "condition": "eq", "keyValue": "={{ $json.source_id }}"}]}
      },
      "id": "d36a667f-2685-4734-84e5-52dc66f45777",
      "name": "Find Delivery State",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [720, 0],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const source = $('Normalize Posts').item.json;\nconst saved = $json;\nif (saved.source_id && saved.signature === source.signature) return [];\nconst action = saved.message_id ? 'edit' : 'create';\nconst footer = action === 'edit' ? 'JunctionNow • Updated' : 'JunctionNow';\nconst embed = {title: source.title, description: source.body || undefined, url: source.url || undefined, footer: {text: footer}};\nif (source.published_at) embed.timestamp = source.published_at;\nreturn [{json: {...source, action, message_id: saved.message_id || '', payload: {content: '', embeds: [embed], allowed_mentions: {parse: [], roles: [], users: [], replied_user: false}}}}];"
      },
      "id": "d84488e2-c5a7-4e53-873e-7839ab3765dd",
      "name": "Choose Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3},
          "conditions": [{"id": "b996ec12-552f-44e8-b156-1d6531ac8cd4", "leftValue": "={{ $json.action }}", "rightValue": "create", "operator": {"type": "string", "operation": "equals"}}],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2e504661-afae-44f5-84c5-413c9a66a3f3",
      "name": "New Post",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://discord.com/api/v10/channels/{{ $vars.DISCORD_CHANNEL_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.payload) }}",
        "options": {"batching": {"batch": {"batchSize": 1, "batchInterval": 300}}, "response": {"response": {"fullResponse": true, "neverError": true, "responseFormat": "json"}}}
      },
      "id": "eb441717-3540-4863-a4e9-c7ca58a1e5bb",
      "name": "Create Discord Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, -120],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://discord.com/api/v10/channels/{{ $vars.DISCORD_CHANNEL_ID }}/messages/{{ $json.message_id }}",
